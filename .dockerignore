# Application properties (keep only what's needed)
application-local.properties
application-dev.properties

# Temporary files
tmp/
temp/
*.tmp

# Docker files themselves
Dockerfile*
docker-compose*.yml
.dockerignore

# Node modules (if you have frontend)
node_modules/
